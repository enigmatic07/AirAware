# ==============================================================================
# AirAware Environment Configuration Template
# ==============================================================================
# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT:
#   cp .env.example .env
#
# DO NOT COMMIT REAL CREDENTIALS TO GIT.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER-SIDE SECRETS (Vercel Serverless Functions ONLY)
# ------------------------------------------------------------------------------
# In Vercel, configure these under: Project Settings > Environment Variables.
# NEVER prefix these with VITE_ to prevent Vite from baking them into client JS.

# Google AI Studio Gemini API Key (starts with AIzaSy...)
GEMINI_API_KEY=your_server_side_gemini_api_key_here

# Gemini Model Identifier (Default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Upstash Redis for Distributed Multi-Instance Rate Limiting (REQUIRED in Production)
# Create a free Redis database at https://console.upstash.com
# IN PRODUCTION (NODE_ENV=production): Both variables are strictly required (Fail-Closed architecture).
# IN DEVELOPMENT: If omitted, AirAware safely uses local sliding-window in-memory rate limiting.
UPSTASH_REDIS_REST_URL=https://your-upstash-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Server-Side Firebase Configuration (REQUIRED for cryptographic token verification)
# Set to your Firebase Project ID to verify ID token audience ("aud") and issuer ("iss").
FIREBASE_PROJECT_ID=your-project-id
# (Optional) Server-side Service Account private key or JSON credentials:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."


# ------------------------------------------------------------------------------
# 2. CLIENT-SIDE PUBLIC IDENTIFIERS (React Frontend)
# ------------------------------------------------------------------------------
# These variables use the VITE_ prefix, meaning Vite will expose them in the
# client JavaScript bundle. Only place non-secret, public identifiers here.
# NEVER put service account JSON, private keys, or admin tokens here.

# Firebase Web App Configuration (From Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# (Optional) India Open Government Data (data.gov.in) API Key
VITE_DATA_GOV_IN_API_KEY=your_cpcb_ogd_api_key_here
